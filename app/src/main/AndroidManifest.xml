<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET: the optional Strava upload (Phase 5, D-79) and the online map (D-90), HTTPS only
      (SEC-NET-01): www.strava.com, api-v3.strava.com, the token server and tiles.openfreemap.org.
      ACCESS_NETWORK_STATE comes from :platform (online map, D-90).
      ACCESS_WIFI_STATE from MapLibre stays removed: not needed.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <application
        android:name=".RideCompApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideComp"
        tools:targetApi="tiramisu">
        <!--
            Exported: launcher activity (SEC-PLT-01). singleTask so the Strava redirect returns to the
            running app (onNewIntent) instead of opening a second copy on top of the browser.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                "Open with RideComp" for GPX files (T3.1, D-44): content URIs only, no BROWSABLE (web pages
                cannot trigger it). The file is parsed as untrusted input (SEC-IN-01..04).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <!--
                Strava OAuth redirect (T5.2, SEC-AUTH-03): exactly ridecomp://localhost/strava-auth. BROWSABLE
                is required for the browser to return here; the app checks the random state (SEC-AUTH-02).
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="localhost"
                    android:path="/strava-auth"
                    android:scheme="${stravaRedirectScheme}" />
            </intent-filter>
        </activity>
        <!-- SEC-PLT-04: FileProvider for exported FIT/GPX files; not exported, temporary grants only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!--
          Home screen widget (T9.2, D-96). RULE-EXCEPTION: exported because the launcher delivers
          APPWIDGET_UPDATE (a protected system broadcast) to it; it reads nothing from the intent beyond the
          widget ids and only renders local data. Requested by the owner.
        -->
        <receiver
            android:name=".widget.RideCompWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ridecomp_widget_info" />
        </receiver>
    </application>

</manifest>
