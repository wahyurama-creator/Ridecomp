<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (T9.2, RemoteViews): title, today / riding line, this week, start button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textColor="@color/widget_accent"
        android:textSize="@dimen/widget_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:maxLines="2"
        android:text="@string/widget_no_plan"
        android:textColor="@color/widget_text"
        android:textSize="@dimen/widget_line1_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_line2_size" />

    <TextView
        android:id="@+id/widget_start"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_button_height"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:text="@string/widget_start_ride"
        android:textColor="@color/widget_on_accent"
        android:textSize="@dimen/widget_button_size"
        android:textStyle="bold" />
</LinearLayout>
