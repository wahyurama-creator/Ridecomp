<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-NET-01: HTTPS only, for every domain, in every build type. No user-added CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
