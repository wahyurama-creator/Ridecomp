<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules (SEC-STO-03, decision D-15).
    Cloud backup: nothing. Ride data contains home locations and health data; RideComp has its own
    (optionally encrypted) backup & restore (F-19), and the PRD keeps data on the device only.
    Device-to-device transfer (local, cable/Wi-Fi Direct): rides and settings are copied so a new phone
    keeps its history. The Strava app and tokens (Phase 5, D-79) live in noBackupFilesDir, which Android
    leaves out of both, and are encrypted with a Keystore key that never leaves this phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <!-- MapLibre's cache of online map tiles (D-90): it hints at places ridden; rebuilt on the new phone. -->
        <exclude domain="file" path="mbgl-offline.db" />
    </device-transfer>
</data-extraction-rules>
