<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (T9.2): 4×2, updated by the system every 30 min (more often only while riding). -->
<!-- previewLayout and targetCell* are Android 12+ only; older launchers ignore them and use minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_ride"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/widget_ride"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
