    <string name="detail_formats_subtitle">Which file to pick</string>
    <string name="detail_format_fit">FIT</string>
    <string name="detail_format_fit_text">The full recording of the ride: route, time, speed, climbing, heart rate, cadence and power. The format bike computers (Garmin, Wahoo) use. Pick it for Strava, Garmin Connect or TrainingPeaks.</string>
    <string name="detail_format_gpx">GPX</string>
    <string name="detail_format_gpx_text">Mainly the route line with times, without the full sensor data. Pick it to share the route with a friend or to follow it again in Komoot or a map app.</string>
    <string name="detail_formats_advice">Not sure? Pick FIT: it keeps everything you recorded.</string>
