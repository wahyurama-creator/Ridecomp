    <string name="battery_help_title">HP saya mematikan app</string>
    <string name="battery_help_intro">HP kamu: %1$s. Lakukan langkah di bawah sekali saja agar ride panjang tidak terhenti.</string>
    <string name="battery_help_xiaomi">Setelan → Aplikasi → RideComp → Penghemat baterai: Tanpa batasan. Lalu Mulai otomatis: aktif. Kunci RideComp di aplikasi terbaru.</string>
    <string name="battery_help_oppo">Setelan → Baterai → Manajemen baterai aplikasi → RideComp: izinkan aktivitas latar dan peluncuran otomatis.</string>
    <string name="battery_help_vivo">Setelan → Baterai → Konsumsi daya latar belakang → RideComp: izinkan. Aktifkan juga Mulai otomatis di i Manager.</string>
    <string name="battery_help_transsion">Phone Master → Manajemen aplikasi → Mulai otomatis: RideComp aktif. Baterai → RideComp: tanpa batasan.</string>
    <string name="battery_help_samsung">Setelan → Baterai → Batas penggunaan latar → keluarkan RideComp dari aplikasi tidur. Baterai aplikasi: Tidak dibatasi.</string>
    <string name="battery_help_generic">Setelan → Aplikasi → RideComp → Baterai: Tidak dibatasi / Jangan optimalkan.</string>
    <string name="battery_help_more">BANTUAN LAIN UNTUK HP KAMU</string>
    <string name="safety_title">Keselamatan</string>
