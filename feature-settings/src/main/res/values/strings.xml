    <string name="battery_help_title">My phone kills the app</string>
    <string name="battery_help_intro">Your phone: %1$s. Do the steps below once so long rides are not stopped.</string>
    <string name="battery_help_xiaomi">Settings → Apps → RideComp → Battery saver: No restrictions. Then Autostart: on. Lock RideComp in recent apps.</string>
    <string name="battery_help_oppo">Settings → Battery → App battery management → RideComp: allow background activity and auto launch.</string>
    <string name="battery_help_vivo">Settings → Battery → Background power consumption → RideComp: allow. Also enable Autostart in i Manager.</string>
    <string name="battery_help_transsion">Phone Master → App management → Auto-start: RideComp on. Battery → RideComp: no restriction.</string>
    <string name="battery_help_samsung">Settings → Battery → Background usage limits → remove RideComp from sleeping apps. App battery: Unrestricted.</string>
    <string name="battery_help_generic">Settings → Apps → RideComp → Battery: Unrestricted / Do not optimise.</string>
    <string name="battery_help_more">MORE HELP FOR YOUR PHONE</string>
